{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "rewrites": [
    { "source": "/ar", "destination": "/index.html" },
    { "source": "/ar/", "destination": "/index.html" },
    { "source": "/calibration", "destination": "/index.html" },
    { "source": "/calibration/", "destination": "/index.html" },
    { "source": "/moon-info", "destination": "/index.html" },
    { "source": "/moon-info/", "destination": "/index.html" },
    { "source": "/debug", "destination": "/index.html" },
    { "source": "/debug/", "destination": "/index.html" }
  ]
}
